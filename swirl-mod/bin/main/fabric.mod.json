{
  "schemaVersion": 1,
  "id": "swirl_client",
  "version": "${version}",
  "name": "Gleam Client",
  "description": "The in-game menu, HUD, and verified server companion for Gleam profiles.",
  "environment": "*",
  "entrypoints": {
    "client": ["app.swirl.client.SwirlClient"],
    "main": ["app.swirl.identity.SwirlIdentityServer"]
  },
  "mixins": ["swirl_client.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
